[Unit]
Description=Mount firmware symlinked by disksymlink service
After=disksymlink.service
Requires=disksymlink.service
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target qcrosvm.service

[Service]
User=root
Group=root
SupplementaryGroups=disk
RemainAfterExit=yes
Type=oneshot

ExecStartPre=/bin/mkdir -p /usr/lib/firmware/qcom
ExecStart=/bin/sh -c 'mountpoint -q /usr/lib/firmware/qcom || mount -t vfat -o ro,defaults /dev/disk/by-partlabel/modem /usr/lib/firmware/qcom'

[Install]
WantedBy=multi-user.target
