[Unit]
Description=Mount bluetooth symlinked by disksymlink service
After=disksymlink.service

[Service]
User=root
Group=root
SupplementaryGroups=disk
RemainAfterExit=yes
Type=oneshot

ExecStarti=/bin/mount -t auto -o ro,defaults,nofail /dev/disk/by-partlabel/bluetooth /bluetooth

[Install]
WantedBy=safe-ivi.target
WantedBy=nonsafe-ivi.target
WantedBy=flex.target
WantedBy=slt.target
WantedBy=single-gvm.target
WantedBy=multi-gvm.target
