[Unit]
Description=Mount la bootloader symlinked by disksymlink service
After=disksymlink.service
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target qcrosvm.service

[Service]
User=root
Group=root
SupplementaryGroups=disk
RemainAfterExit=yes
Type=oneshot

ExecStart=/bin/mount -t ext4 -o ro,defaults /dev/disk/by-partlabel/la_bootloader /firmware/vm/boot/autoghgvm

[Install]
WantedBy=multi-user.target
