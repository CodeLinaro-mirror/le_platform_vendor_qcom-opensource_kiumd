[Unit]
Description=Mount bluetooth out of fstab

[Mount]
What=/dev/disk/by-partlabel/bluetooth
Where=/bluetooth
Type=auto
Options=ro,defaults,nofail

[Install]
WantedBy=safe-ivi.target
WantedBy=nonsafe-ivi.target
WantedBy=flex.target
WantedBy=slt.target
WantedBy=single-gvm.target
WantedBy=multi-gvm.target
