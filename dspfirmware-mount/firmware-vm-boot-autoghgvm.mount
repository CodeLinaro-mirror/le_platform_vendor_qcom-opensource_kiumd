[Unit]
Description=Mount LA GVM boot Images

[Mount]
What=/dev/disk/by-partlabel/la_bootloader
Where=/firmware/vm/boot/autoghgvm
Type=ext4
Options=defaults

[Install]
WantedBy=multi-user.target
