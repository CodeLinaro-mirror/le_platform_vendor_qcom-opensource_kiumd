[Unit]
Description=Mount LV GVM boot Images

[Mount]
What=/dev/disk/by-partlabel/lv_boot
Where=/firmware/lvgvm/boot
Type=ext4
Options=defaults,nofail

[Install]
WantedBy=multi-user.target
