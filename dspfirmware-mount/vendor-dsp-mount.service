[Unit]
Description=Mount DSP symlinked by disksymlink service
After=disksymlink.service
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target qcrosvm.service

[Service]
User=root
Group=root
SupplementaryGroups=disk
RemainAfterExit=yes
Type=oneshot

ExecStartPre=/bin/mkdir -p /vendor/dsp
ExecStart=/bin/sh -c 'mountpoint -q /vendor/dsp || mount -t ext4 -o ro,defaults,nofail /dev/disk/by-partlabel/dsp /vendor/dsp'

[Install]
WantedBy=multi-user.target
