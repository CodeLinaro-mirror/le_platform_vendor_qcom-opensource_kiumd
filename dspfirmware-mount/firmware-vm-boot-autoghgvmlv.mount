[Unit]
Description=Mount LV GVM boot Images

[Mount]
What=/dev/disk/by-partlabel/lv_bootloader
Where=/firmware/vm/boot/autoghgvmlv
Type=ext4
Options=ro,defaults,nofail

[Install]
WantedBy=multi-user.target
